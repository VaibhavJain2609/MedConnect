# Frontend build context (. / frontend). The Dockerfile does `COPY . .`, so
# anything not listed here ends up inside the image.

# Dependencies are installed via `npm ci` inside the image — never copy a
# host node_modules (wrong platform binaries, huge context).
node_modules

# Build output — a stale local build must never clobber `next build`
.next
out
*.tsbuildinfo

# Secrets / local env
.env
.env.*
!.env.example

# Tests & coverage. `tests/` MUST stay in the context: src/**/__tests__/*.tsx
# import ../../tests/utils/test-utils and tests/mocks/* — `next build`
# type-checks those imports, so excluding this dir breaks the image build
# (verified: production build fails TS2307 without it). The builder stage
# uses it only for type-checking; the runtime image never sees it.
coverage
jest.config.js

# Repo/build metadata
.git
.gitignore
.dockerignore
Dockerfile

# OS / editor noise
.DS_Store
.idea
.vscode
*.swp
*.swo
*.log
