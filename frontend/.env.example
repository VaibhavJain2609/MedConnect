# MedConnect Frontend - Environment Variables
# Copy this file to .env.local and fill in your values.

# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Keycloak server URL (no trailing slash)
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080

# Keycloak realm name
NEXT_PUBLIC_KEYCLOAK_REALM=medconnect

# Keycloak frontend client ID
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=medconnect-frontend

# Sentry DSN (optional) — when unset, all Sentry init/capture calls are
# silent no-ops. Origin is auto-allowed in the CSP connect-src.
NEXT_PUBLIC_SENTRY_DSN=

# App environment reported to Sentry (defaults to "development")
NEXT_PUBLIC_APP_ENV=development
