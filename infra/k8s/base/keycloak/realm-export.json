{
  "realm": "medconnect",
  "enabled": true,
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "sslRequired": "external",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "defaultSignatureAlgorithm": "RS256",
  "roles": {
    "realm": [
      {
        "name": "patient",
        "description": "Patient role",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "doctor",
        "description": "Doctor role",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "admin",
        "description": "Admin role",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "defaultRoles": ["patient"],
  "clients": [
    {
      "clientId": "medconnect-frontend",
      "name": "MedConnect Frontend",
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "PLACEHOLDER_FRONTEND_ORIGIN/*"
      ],
      "webOrigins": [
        "PLACEHOLDER_FRONTEND_ORIGIN",
        "+"
      ],
      "baseUrl": "PLACEHOLDER_FRONTEND_ORIGIN/",
      "adminUrl": "PLACEHOLDER_FRONTEND_ORIGIN/",
      "rootUrl": "PLACEHOLDER_FRONTEND_ORIGIN/",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "token.endpoint.auth.method": "none",
        "oidc.token.channel.claims.enabled": "true",
        "client.session.idle.timeout": "0",
        "client.session.max.lifespan": "0",
        "client.offline.session.idle.timeout": "0",
        "client.offline.session.max.lifespan": "0"
      },
      "defaultClientScopes": [
        "profile",
        "email",
        "roles"
      ],
      "optionalClientScopes": [
        "offline_access"
      ],
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "email",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email",
            "jsonType.label": "String"
          }
        },
        {
          "name": "name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "name",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "claim.name": "name",
            "jsonType.label": "String"
          }
        },
        {
          "name": "medconnect-backend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "medconnect-backend",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "medconnect-backend",
      "name": "MedConnect Backend",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "medconnect-backend-admin",
      "name": "MedConnect Backend Admin (service account)",
      "description": "Dedicated service-account client (client_credentials grant) for backend Admin REST calls. Replaces the master-realm `admin-cli` password grant still used by backend/app/utils/keycloak_admin.py — the app-side migration to client_credentials is a tracked follow-up; until it lands, admin-cli remains in use. Client secret is provisioned out-of-band (Secrets Manager -> ExternalSecret), not stored in this export.",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "service-account-medconnect-backend-admin",
      "enabled": true,
      "emailVerified": false,
      "serviceAccountClientId": "medconnect-backend-admin",
      "clientRoles": {
        "realm-management": [
          "manage-users"
        ]
      }
    }
  ]
}
