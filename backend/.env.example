APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
# Comma-separated Host-header allowlist (TrustedHostMiddleware). Empty =
# disabled. Recommended in production, e.g.:
# ALLOWED_HOSTS=api.example.com,medconnect.example.com
ALLOWED_HOSTS=
DATABASE_URL=postgresql+asyncpg://USER:PASS@postgres:5432/medconnect
DATABASE_URL_SYNC=postgresql://USER:PASS@postgres:5432/medconnect
MEDICINE_DB_URL=postgresql+asyncpg://USER:PASS@postgres:5432/medconnect_medicines
MEDICINE_DB_URL_SYNC=postgresql://USER:PASS@postgres:5432/medconnect_medicines
REDIS_URL=redis://:REDIS_PASS@redis:6379/0
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=medconnect
KEYCLOAK_CLIENT_ID=medconnect-backend
VERIFY_JWT_AUDIENCE=true
# Keycloak admin REST credentials — MUST be non-default in production
# (the startup guard rejects admin/admin under APP_ENV=production).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
SENTRY_DSN=
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
STORAGE_BACKEND=local
UPLOADS_DIR=/tmp/medconnect-uploads
