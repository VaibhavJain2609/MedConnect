# docker-compose.yml interpolates these into container env vars.
# Copy to .env (gitignored) and fill in real values — never commit .env.
POSTGRES_USER=medconnect
POSTGRES_PASSWORD=CHANGE_ME
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
# Optional — uvicorn worker count for the backend service (default 1).
# UVICORN_WORKERS=2
